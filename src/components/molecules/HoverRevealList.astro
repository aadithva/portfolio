---
import { existsSync } from "node:fs";
import { join } from "node:path";
import type { Project } from "@/types";
import { getWorkItemsFor } from "@/data/work";
import { optimizedProjectPreview } from "@/data/projectPreviews";

interface Props {
  projects: Project[];
  showViewAll?: boolean;
}
const { projects, showViewAll = false } = Astro.props;

const isPublicImage = (thumbnail: string) => !thumbnail.includes("placeholder") && (
    /^https?:\/\//.test(thumbnail) ||
    (thumbnail.length > 0 &&
      existsSync(join(process.cwd(), "public", thumbnail.replace(/^\/+/, ""))))
);
const work = projects.map((project, index) => {
  // Public case-study images explain the work better than a sign-in screen.
  // Protected case sections never contribute images to the public index.
  const publicSections = project.passwordProtected ? [] : [
    ...project.sections,
    ...getWorkItemsFor(project.slug).filter((item) => !item.passwordProtected).flatMap((item) => item.sections),
  ];
  const preview = publicSections
    .flatMap((section) => (section.images ?? []).map((src) => ({ src, caption: section.caption })))
    .find((image) => isPublicImage(image.src));
  const thumbnail = optimizedProjectPreview(preview?.src ?? project.thumbnail?.trim() ?? "");
  return {
    project, index: String(index + 1).padStart(2, "0"), thumbnail,
    thumbnailAvailable: isPublicImage(thumbnail),
    imageDescription: preview?.caption ?? `${project.title} project preview`,
  };
});
---

<div class="work-index">
  {work.map(({ project, index, thumbnail, thumbnailAvailable, imageDescription }, i) => (
    <a class="work-index__row" href={`/work/${project.slug}`}>
      <div class:list={["work-index__visual", { "work-index__visual--unavailable": !thumbnailAvailable }]}>
        {thumbnailAvailable ? (
          <img
            src={thumbnail}
            alt={imageDescription}
            width="1440"
            height="900"
            loading={i === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        ) : (
          <>
            <span class="work-index__placeholder-title">{project.title}</span>
            <span class="work-index__placeholder-note">No public project imagery</span>
          </>
        )}
      </div>
      <div class="work-index__body">
        <div class="work-index__meta">
          <span>{index} <span aria-hidden="true">/</span> {project.category}</span>
          <span>{project.year}</span>
        </div>
        <h2 class="work-index__title">{project.title}</h2>
        <p class="work-index__description">{project.description}</p>
        <span class="work-index__cta">View project <span aria-hidden="true">↗</span></span>
      </div>
    </a>
  ))}
  {showViewAll && (
    <div class="work-index__viewall">
      <a class="text-link" href="/work">All projects <span aria-hidden="true">→</span></a>
    </div>
  )}
</div>
