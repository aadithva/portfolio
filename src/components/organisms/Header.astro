---
import { navLinks } from "@/data/navigation";
import { siteConfig } from "@/data/siteConfig";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  path === href || path.startsWith(href + "/");
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${siteConfig.name}, home`}>
      <span class="site-header__wordmark" aria-hidden="true">AADITH<span class="site-header__mark">.</span></span>
      <span class="site-header__home">The room <span aria-hidden="true">↗</span></span>
    </a>

    <nav class="nav" aria-label="Primary" data-tactile-dock>
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={["nav__link", { "is-active": isActive(link.href) }]}
          aria-current={isActive(link.href) ? "page" : undefined}
          data-dock-item
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
