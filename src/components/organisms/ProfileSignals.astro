---
import Line from "@/components/atoms/Line.astro";
import Reveal from "@/components/atoms/Reveal.astro";
import SectionLabel from "@/components/atoms/SectionLabel.astro";

const signals = [
  {
    title: "Making Copilot answers easier to check",
    body: "At Microsoft, I work on how Copilot answers are structured and sourced. I also help evaluate response quality and review accessibility details.",
    href: "/work/microsoft-copilot",
    link: "See the Microsoft work",
  },
  {
    title: "What paid work is teaching us at Owly",
    body: "At Owly, I speak with customers and design the product alongside my co-founders. We use demos and paid projects to learn which parts of the video workflow are worth turning into software.",
    href: "/work/owly-studio",
    link: "See the Owly story",
  },
  {
    title: "Testing interactions in code",
    body: "I use code to test behaviour that a static mockup cannot show. When a fix is small and low risk, I can make it directly and ask an engineer to review it.",
    href: "/lab",
    link: "Open the lab",
  },
];
---

<section class="profile-signals container" aria-labelledby="profile-signals-heading">
  <Line />
  <div class="profile-signals__intro">
    <Reveal>
      <SectionLabel>The short version</SectionLabel>
    </Reveal>
    <Reveal delay={80}>
      <h2 id="profile-signals-heading" class="profile-signals__statement">
        I'm most useful when a product problem crosses team boundaries and a polished mockup will not settle it.
      </h2>
    </Reveal>
  </div>

  <div class="profile-signals__grid">
    {signals.map((signal, i) => (
      <Reveal class="profile-signal" delay={i * 80}>
        <span class="profile-signal__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        <div>
          <h3 class="profile-signal__title">{signal.title}</h3>
          <p class="profile-signal__body">{signal.body}</p>
          <a class="text-link profile-signal__link" href={signal.href}>{signal.link} &rarr;</a>
        </div>
      </Reveal>
    ))}
  </div>
</section>
