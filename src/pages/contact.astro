---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Reveal from "@/components/atoms/Reveal.astro";
import SectionLabel from "@/components/atoms/SectionLabel.astro";
import Line from "@/components/atoms/Line.astro";
import { siteConfig } from "@/data/siteConfig";

const elsewhere = [
  { label: "LinkedIn", href: siteConfig.social.linkedin },
  { label: "Behance", href: siteConfig.social.behance },
];
---
<BaseLayout title="Contact" description="Get in touch with Aadith about AI product design, Owly, or working together.">
  <div class="page container">
    <Reveal>
      <h1 class="page-header__title">Say hello</h1>
      <p class="page-header__intro">Hiring a product designer for a complicated AI system? Building a creative tool or curious about Owly? I would like to hear from you.</p>
    </Reveal>

    <div class="spacer-xl"></div>
    <Line />
    <div class="spacer-xl"></div>

    <Reveal>
      <a class="contact-email" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </Reveal>

    <div style="height:clamp(2.5rem,4vw,4rem)"></div>

    <Reveal>
      <p class="muted-note">Hyderabad, India&nbsp;&nbsp;·&nbsp;&nbsp;IST (UTC +5:30)&nbsp;&nbsp;·&nbsp;&nbsp;I usually reply within a day</p>
    </Reveal>

    <div class="spacer-xl"></div>

    <Reveal class="prose">
      <p>I fit best on teams where design stays close to how the product works. I am especially interested in AI and creative tools. I like roles where I can research the problem, test an interaction in code, then stay involved while engineers build it.</p>
      <p>If you want to discuss Owly as a founder or investor, I can share what paid customer work is teaching us and which parts of the video process still need to become software. You can also write about design or cycling.</p>
    </Reveal>

    <div class="spacer-xl"></div>
    <Line />
    <div style="height:3rem"></div>

    <Reveal>
      <SectionLabel>Elsewhere</SectionLabel>
      <div style="height:2rem"></div>
      <div class="elsewhere-list">
        {elsewhere.map((l) => (
          <a class="elsewhere-link" href={l.href} target="_blank" rel="noopener noreferrer">
            {l.label}<span class="elsewhere-link__arrow">→</span>
          </a>
        ))}
      </div>
    </Reveal>
  </div>
</BaseLayout>
