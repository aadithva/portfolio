---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Reveal from "@/components/atoms/Reveal.astro";
import SectionLabel from "@/components/atoms/SectionLabel.astro";
import Line from "@/components/atoms/Line.astro";
import { writingNotes } from "@/data/writing";
---
<BaseLayout title="Writing" description="Notes on using AI in product design and writing system messages for chat.">
  <div class="page container">
    <Reveal>
      <h1 class="page-header__title">Writing</h1>
      <p class="page-header__intro">Notes on what changes when an idea meets a working prototype or evidence that proves me wrong.</p>
    </Reveal>

    {writingNotes.map((note) => (
      <>
        <div class="spacer-xl"></div>
        <Line />
        <div class="spacer-xl"></div>

        <article class="essay" id={note.id}>
          <Reveal>
            <SectionLabel>{note.label}</SectionLabel>
            <div style="height:2rem"></div>
            <h2 class="essay__title">{note.title}</h2>
          </Reveal>

          {note.paragraphs.map((paragraph, paragraphIndex) => (
            <Reveal delay={Math.min(60 + paragraphIndex * 30, 180)}>
              <p>{paragraph}</p>
            </Reveal>
          ))}

          <Reveal delay={180}>
            <blockquote class="essay__pullquote">
              <p>"{note.pullquote}"</p>
            </blockquote>
          </Reveal>
        </article>
      </>
    ))}

    <div class="spacer-xl"></div>
    <Line />
    <div style="height:3rem"></div>

    <Reveal>
      <p class="muted-note">
        More notes are still in drafts.&nbsp;&nbsp;<a class="inline-link" href="https://x.com/aadithva" target="_blank" rel="noopener noreferrer">Follow on X</a>&nbsp;to see the next one when it is ready.
      </p>
    </Reveal>
  </div>
</BaseLayout>
