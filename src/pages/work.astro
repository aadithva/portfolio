---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Reveal from "@/components/atoms/Reveal.astro";
import HoverRevealList from "@/components/molecules/HoverRevealList.astro";
import { projects } from "@/data/projects";
---
<BaseLayout title="Work" description="Six projects covering Microsoft Copilot, Owly, fintech, Web3, and earlier product and data work.">
  <div class="page container">
    <Reveal>
      <h1 class="page-header__title">Work</h1>
      <p class="page-header__intro">These six entries cover Microsoft Copilot, Owly, fintech, Web3, and earlier product and data work. Some have full case studies. Others are shorter because I only include details I can verify.</p>
    </Reveal>

    <div class="spacer-md"></div>

    <HoverRevealList projects={projects} />
  </div>
</BaseLayout>
